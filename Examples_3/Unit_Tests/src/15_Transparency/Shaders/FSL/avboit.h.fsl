#ifdef AVBOIT_EXTINCTION_UAV
RES(RWBuffer(uint), VolumeExtinctionBufferUAV, UPDATE_FREQ_NONE, u1, binding = 5);
#endif

#ifdef AVBOIT_LUT_UAV
RES(WTex3D(float4), VolumeTransmittanceLutUAV, UPDATE_FREQ_NONE, u2, binding = 6);
#endif

#ifdef AVBOIT_ORDERED_ACCESS
RES(Buffer(uint), VolumeExtinctionBufferSRV, UPDATE_FREQ_NONE, t1, binding = 5);
#endif

#if defined(AVBOIT_ORDERED_ACCESS) || defined(AVBOIT_LUT_SRV)
RES(Tex3D(float4), VolumeTransmittanceLutSRV, UPDATE_FREQ_NONE, t2, binding = 6);
#endif

CBUFFER(AVBOITUniforms, UPDATE_FREQ_PER_FRAME, b5, binding = 10)
{
    DATA(uint, volumeWidth, None);
    DATA(uint, volumeHeight, None);
    DATA(uint, volumeDepth, None);
    DATA(uint, downsampleFactor, None);
    DATA(float, avboitMultiplier, None);
    DATA(uint, avboitDebugView, None);
    DATA(uint, avboitTransmittanceDirection, None);
    DATA(uint, avboitAnalyticFlags, None);
};

#define AVBOIT_TRANSMITTANCE_LEGACY 0u
#define AVBOIT_TRANSMITTANCE_FRONT 1u
#define AVBOIT_WEIGHT_SOURCE_LUT 0u
#define AVBOIT_WEIGHT_SOURCE_CONSTANT 1u
#define AVBOIT_WEIGHT_SOURCE_LAYER_ID 2u
#define AVBOIT_ANALYTIC_FLAG_WEIGHT_SOURCE_MASK 0xFu
#define AVBOIT_ANALYTIC_FLAG_WEIGHT_CONSTANT_075 (1u << 4u)
#define AVBOIT_ANALYTIC_FLAG_WEIGHT_PATTERN_B (1u << 5u)
#define AVBOIT_ANALYTIC_FLAG_DEPTH_MAPPING_REVERSE_CORRECT (1u << 6u)
#define AVBOIT_ANALYTIC_FLAG_DUAL_DIRECTION_DIAGNOSTIC (1u << 7u)
#define AVBOIT_ANALYTIC_LAYER_INVALID 0xFFFFFFFFu
#define AVBOIT_MAX_VOLUME_DEPTH 256u

uint PackExtinction(float ext)
{
    // Fixed-point scaling for AtomicAdd
    return uint(ext * 10000.0f);
}

float UnpackExtinction(uint packed)
{
    return float(packed) / 10000.0f;
}

uint GetVolumeIndex(uint3 coords)
{
    return coords.z * volumeWidth * volumeHeight + coords.y * volumeWidth + coords.x;
}

uint2 GetVolumeXY(uint2 fullResPixel)
{
    uint factor = max(downsampleFactor, 1u);
    return min(fullResPixel / factor, uint2(volumeWidth - 1, volumeHeight - 1));
}

#ifdef AVBOIT_DEPTH_HELPERS
float AVBOITLinearizeLegacyDepth(float deviceDepth)
{
    return Get(camClipInfo)[0] / (Get(camClipInfo)[1] * deviceDepth + Get(camClipInfo)[2]);
}

float AVBOITLinearizeReverseZDepth(float deviceDepth)
{
    return Get(camClipInfo)[0] / (Get(camClipInfo)[1] * (1.0f - deviceDepth) + Get(camClipInfo)[2]);
}

float AVBOITLinearizeDepth(float deviceDepth)
{
    return (Get(avboitAnalyticFlags) & AVBOIT_ANALYTIC_FLAG_DEPTH_MAPPING_REVERSE_CORRECT) != 0u ?
           AVBOITLinearizeReverseZDepth(deviceDepth) : AVBOITLinearizeLegacyDepth(deviceDepth);
}

float AVBOITNormalizeLogDepth(float linearDepth)
{
    float zFar = Get(camClipInfo)[2];
    float zNear = Get(camClipInfo)[0] / zFar;
    return clamp(log2(zFar / linearDepth) / log2(zFar / zNear), 0.0f, 1.0f);
}

uint AVBOITZIndexFromNormalizedDepth(float normalizedDepth)
{
    return clamp(uint(normalizedDepth * volumeDepth), 0, volumeDepth - 1);
}

uint AVBOITComputeZIndex(float deviceDepth)
{
    return AVBOITZIndexFromNormalizedDepth(AVBOITNormalizeLogDepth(AVBOITLinearizeDepth(deviceDepth)));
}
#endif
