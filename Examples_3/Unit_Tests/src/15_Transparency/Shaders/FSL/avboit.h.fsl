#ifdef AVBOIT_EXTINCTION_UAV
RES(RWBuffer(uint), VolumeExtinctionBufferUAV, UPDATE_FREQ_NONE, u1, binding = 5);
#endif

#ifdef AVBOIT_LUT_UAV
RES(WTex3D(float4), VolumeTransmittanceLutUAV, UPDATE_FREQ_NONE, u2, binding = 6);
#endif

#ifdef AVBOIT_ORDERED_ACCESS
RES(Buffer(uint), VolumeExtinctionBufferSRV, UPDATE_FREQ_NONE, t1, binding = 5);
#endif

#if defined(AVBOIT_ORDERED_ACCESS) || defined(AVBOIT_LUT_SRV)
RES(Tex3D(float4), VolumeTransmittanceLutSRV, UPDATE_FREQ_NONE, t2, binding = 6);
#endif

CBUFFER(AVBOITUniforms, UPDATE_FREQ_PER_FRAME, b5, binding = 10)
{
    DATA(uint, volumeWidth, None);
    DATA(uint, volumeHeight, None);
    DATA(uint, volumeDepth, None);
    DATA(uint, downsampleFactor, None);
    DATA(float, avboitMultiplier, None);
    DATA(uint, avboitDebugView, None);
    DATA(uint, avboitTransmittanceDirection, None);
    DATA(uint, avboitAnalyticFlags, None);
};

#define AVBOIT_TRANSMITTANCE_LEGACY 0u
#define AVBOIT_TRANSMITTANCE_FRONT 1u

uint PackExtinction(float ext)
{
    // Fixed-point scaling for AtomicAdd
    return uint(ext * 10000.0f);
}

float UnpackExtinction(uint packed)
{
    return float(packed) / 10000.0f;
}

uint GetVolumeIndex(uint3 coords)
{
    return coords.z * volumeWidth * volumeHeight + coords.y * volumeWidth + coords.x;
}

uint2 GetVolumeXY(uint2 fullResPixel)
{
    uint factor = max(downsampleFactor, 1u);
    return min(fullResPixel / factor, uint2(volumeWidth - 1, volumeHeight - 1));
}
