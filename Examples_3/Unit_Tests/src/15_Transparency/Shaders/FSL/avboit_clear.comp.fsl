#define AVBOIT_EXTINCTION_UAV
#include "avboit.h.fsl"

NUM_THREADS(256, 1, 1)
void CS_MAIN( SV_DispatchThreadID(uint3) DTid )
{
    INIT_MAIN;

    uint voxelIndex = DTid.x;
    uint voxelCount = volumeWidth * volumeHeight * volumeDepth;
    if(voxelIndex < voxelCount)
    {
        Get(VolumeExtinctionBufferUAV)[voxelIndex] = 0;
    }
}
