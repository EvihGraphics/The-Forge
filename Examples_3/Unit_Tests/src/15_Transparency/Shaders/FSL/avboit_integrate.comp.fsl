#define AVBOIT_LUT_UAV
#define AVBOIT_ORDERED_ACCESS
#include "avboit.h.fsl"

NUM_THREADS(8, 8, 1)
void CS_MAIN( SV_DispatchThreadID(uint3) DTid )
{
    INIT_MAIN;

    if(DTid.x >= volumeWidth || DTid.y >= volumeHeight) return;

    float3 transmittance = float3(1.0f, 1.0f, 1.0f);

    if (Get(avboitTransmittanceDirection) == AVBOIT_TRANSMITTANCE_FRONT)
    {
        // LUT stores exclusive front transmittance. The current slice is not included in its own event weight.
        for(uint z = volumeDepth; z > 0; --z)
        {
            uint slice = z - 1u;
            uint3 coords = uint3(DTid.x, DTid.y, slice);
            Write3D(Get(VolumeTransmittanceLutUAV), coords, float4(transmittance, 1.0f));

            uint packedExt = Get(VolumeExtinctionBufferSRV)[GetVolumeIndex(coords)];
            float ext = UnpackExtinction(packedExt);
            transmittance *= exp(-float3(ext, ext, ext));
        }
    }
    else
    {
        for(uint z = 0; z < volumeDepth; ++z)
        {
            uint3 coords = uint3(DTid.x, DTid.y, z);
            uint packedExt = Get(VolumeExtinctionBufferSRV)[GetVolumeIndex(coords)];
            float ext = UnpackExtinction(packedExt);

            transmittance *= exp(-float3(ext, ext, ext));

            Write3D(Get(VolumeTransmittanceLutUAV), coords, float4(transmittance, 1.0f));
        }
    }
}
