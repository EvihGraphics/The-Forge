#define AVBOIT_LUT_UAV
#define AVBOIT_ORDERED_ACCESS
#include "avboit.h.fsl"

NUM_THREADS(8, 8, 1)
void CS_MAIN( SV_DispatchThreadID(uint3) DTid )
{
    INIT_MAIN;

    if(DTid.x >= volumeWidth || DTid.y >= volumeHeight) return;

    uint activeDepth = min(volumeDepth, AVBOIT_MAX_VOLUME_DEPTH);
    float legacyEventWeights[AVBOIT_MAX_VOLUME_DEPTH];
    float frontEventWeights[AVBOIT_MAX_VOLUME_DEPTH];

    float legacyTransmittance = 1.0f;
    for(uint z = 0; z < activeDepth; ++z)
    {
        uint3 coords = uint3(DTid.x, DTid.y, z);
        legacyEventWeights[z] = legacyTransmittance;
        uint packedExt = Get(VolumeExtinctionBufferSRV)[GetVolumeIndex(coords)];
        float ext = UnpackExtinction(packedExt);
        legacyTransmittance *= exp(-ext);
    }

    float frontTransmittance = 1.0f;
    for(uint z = activeDepth; z > 0; --z)
    {
        uint slice = z - 1u;
        uint3 coords = uint3(DTid.x, DTid.y, slice);
        frontEventWeights[slice] = frontTransmittance;
        uint packedExt = Get(VolumeExtinctionBufferSRV)[GetVolumeIndex(coords)];
        float ext = UnpackExtinction(packedExt);
        frontTransmittance *= exp(-ext);
    }

    for(uint z = 0; z < activeDepth; ++z)
    {
        float legacyWeight = legacyEventWeights[z];
        float frontWeight = frontEventWeights[z];
        float selectedWeight = Get(avboitTransmittanceDirection) == AVBOIT_TRANSMITTANCE_FRONT ? frontWeight : legacyWeight;
        uint3 coords = uint3(DTid.x, DTid.y, z);
        Write3D(Get(VolumeTransmittanceLutUAV), coords, float4(selectedWeight, legacyWeight, frontWeight, legacyTransmittance));
    }
}
